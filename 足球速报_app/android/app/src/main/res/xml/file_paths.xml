<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 授权路径：App 内更新 apk 在 cache/update/，分享卡片图在 cache/share/ -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="update_cache" path="update/" />
    <external-cache-path name="update_external" path="update/" />
    <cache-path name="share_cache" path="share/" />
    <external-cache-path name="share_external" path="share/" />
</paths>
